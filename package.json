{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@nozomiishii/renovate",
  "version": "0.0.0",
  "description": "🦄 Reborn Renovate",
  "keywords": [
    "config",
    "renovate"
  ],
  "homepage": "https://github.com/nozomiishii/renovate#readme",
  "bugs": {
    "url": "https://github.com/nozomiishii/renovate/issues"
  },
  "license": "MIT",
  "author": "Nozomi Ishii",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nozomiishii/renovate.git"
  },
  "bin": "bin/cli.sh",
  "type": "module",
  "main": "default.json",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "pnpm oxfmt . --check",
    "format:fix": "pnpm oxfmt .",
    "oxfmt": "oxfmt",
    "postinstall": "postinstall",
    "validate": "renovate-config-validator --strict default.json"
  },
  "devDependencies": {
    "@nozomiishii/commitlint-config": "2.8.1",
    "@nozomiishii/lefthook-config": "2.8.1",
    "@nozomiishii/markdownlint-cli2-config": "2.8.1",
    "@nozomiishii/oxfmt-config": "2.8.1",
    "@nozomiishii/postinstall": "2.8.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "renovate": "44.164.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  }
}
