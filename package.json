{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@nozomiishii/renovate",
  "version": "0.0.0",
  "description": "🦄 Reborn Renovate",
  "keywords": [
    "renovate",
    "config"
  ],
  "homepage": "https://github.com/nozomiishii/renovate#readme",
  "bugs": {
    "url": "https://github.com/nozomiishii/renovate/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nozomiishii/renovate.git"
  },
  "license": "MIT",
  "author": "Nozomi Ishii",
  "type": "module",
  "main": "default.json",
  "bin": "bin/cli.sh",
  "scripts": {
    "format": "pnpm prettier . --check",
    "format:fix": "pnpm prettier . --write",
    "postinstall": "postinstall",
    "prettier": "prettier --ignore-unknown --cache",
    "validate": "renovate-config-validator --strict default.json"
  },
  "devDependencies": {
    "@nozomiishii/commitlint-config": "2.5.0",
    "@nozomiishii/lefthook-config": "2.5.0",
    "@nozomiishii/markdownlint-cli2-config": "2.5.0",
    "@nozomiishii/postinstall": "2.5.0",
    "@nozomiishii/prettier-config": "2.5.0",
    "lefthook": "2.1.12",
    "renovate": "44.48.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
